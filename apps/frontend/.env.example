# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Ably (realtime chat + spaces) ---
# Server-side API key from https://ably.com/ (Account > Apps > API Keys).
# Needs the capabilities you grant in app/api/ably/route.ts.
ABLY_API_KEY=your-ably-app.key:secret

# --- Neon Postgres (Drizzle ORM) ---
# Pooled connection string (used at runtime).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Neon branch name (informational / tooling).
NEON_BRANCH=production
# Unpooled/direct connection string (used by drizzle-kit migrations).
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# --- WorkOS AuthKit (authentication) ---
# From the WorkOS dashboard (https://dashboard.workos.com/).
WORKOS_CLIENT_ID=client_xxxxxxxxxxxxxxxxxxxxxxxxx
WORKOS_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxx
# Must match a redirect URI registered in WorkOS. Public (exposed to browser).
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# Random 32+ character string used to encrypt the session cookie.
# Generate one with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=generate-a-secure-32-char-minimum-secret
